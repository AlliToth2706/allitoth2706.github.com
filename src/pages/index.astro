---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Typewriter from "../components/Typewriter.svelte";
import Navbar from "../components/Navbar.astro";
import PageSection from "../components/PageSection.astro";
import ContactForm from "../components/ContactForm.jsx";
import SparkleCluster from "../components/SparkleCluster.svelte";
import AboutArea from "../components/AboutArea.astro";
import SkillsArea from "../components/SkillsArea.astro";
import Heading from "../components/Heading.astro";
import SubHeading from "../components/SubHeading.astro";
let a = import.meta.env.DEV;
---

<!-- TODO: change loading from how it looks rn to be just the "hi im alli" text and then have everything else fade in -->
<Layout>
    <div id="content" class="2xl:w-1/2 lg:w-2/3 m-auto">
        <SparkleCluster client:only="svelte" />
        <Navbar invisible={true} />
        <main
            class="m-auto text-md 2xl:text-xl initial snap-both snap-mandatory leading-normal"
        >
            <!-- https://codepen.io/argyleink/pen/yLovWjz css -->
            <!-- <PageSection id="home">
                <ul>
                    <div class="flex items-center justify-center">
                        <Typewriter
                            client:only="svelte"
                            text="Hi, I'm Alli."
                            devMode={a}
                        />
                    </div>
                    <h2
                        class="flex items-center justify-center font-normal text-xl lg:text-3xl animate__animated"
                        id="subheader"
                        data-hidden="true"
                        style="--animate-delay: 0.5s"
                    >
                        I specialise in&nbsp
                        <b
                            class="text-transparent bg-clip-text from-purple-400 to-white bg-gradient-to-b"
                            >Frontend Web Development</b
                        >.
                    </h2>
                </ul>
            </PageSection> -->

            <PageSection id="about" invisible={true}>
                <div
                    class="hidden lg:grid grid-rows-2 content-evenly mt-0 lg:mt-16 2xl:mt-0"
                >
                    <ul class="ml-0 xl:ml-16 mr-6">
                        <SubHeading>About Me</SubHeading>
                        <AboutArea />
                    </ul>

                    <ul class="ml-8 mr-0 xl:mr-6">
                        <SubHeading>Skills</SubHeading>
                        <SkillsArea />
                    </ul>
                </div>

                <ul class="block lg:hidden">
                    <Heading>About Me</Heading>
                    <AboutArea />
                </ul>
            </PageSection>

            <PageSection id="skills" classes="block lg:hidden" invisible={true}>
                <ul>
                    <Heading>Skills</Heading>
                    <SkillsArea />
                </ul>
            </PageSection>

            <PageSection id="projects" invisible={true}>
                <div>
                    <Heading>Projects</Heading>
                    <ul role="list" class="grid grid-cols-3 gap-8 p-0">
                        <Card
                            href="social/"
                            title="Social Media Demo"
                            body="React Demonstraction of a social media website."
                        />
                        <Card
                            href="precision/"
                            title="Precision Electronics"
                            body="A React website I created for a client."
                        />
                        <Card href="#" title="" body="a" />
                        <Card href="#" title="" body="a" />
                        <Card
                            href="website/"
                            title="This website"
                            body="Information about this website."
                        />
                        <Card
                            href="small-projects/"
                            title="Small Projects"
                            body="A collection of other, smaller projects."
                        />
                    </ul>
                </div>
            </PageSection>

            <PageSection id="contact" invisible={true}>
                <ul
                    class="w-96 py-0 mt-0 lg:mt-16 2xl:mt-0 overflow-hidden"
                    style="max-height: calc(100vh - 96px)"
                >
                    <Heading>Contact</Heading>
                    <p class="text-center mb-4">
                        Feel free to contact me down below!
                    </p>
                    <ContactForm client:only="react" />
                </ul>
            </PageSection>
        </main>
    </div>
</Layout>
