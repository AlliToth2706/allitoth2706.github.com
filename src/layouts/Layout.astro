---
interface Props {
    title?: string;
}

const { title = "Alli's Portfolio" } = Astro.props;
---

<!doctype html>
<html
    lang="en"
    class="bg-zinc-900 text-white m-0 scroll-smooth snap-both snap-mandatory overflow-y-scroll h-full"
>
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Astro description" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link
            href="https://static.fontawesome.com/css/fontawesome-app.css"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
        />
    </head>
    <body class="bg-zinc-900 text-white m-0 h-full">
        <slot />
    </body>
</html>
<style is:global>
    html {
        font-family: system-ui, sans-serif;
    }

    code {
        font-family:
            Menlo,
            Monaco,
            Lucida Console,
            Liberation Mono,
            DejaVu Sans Mono,
            Bitstream Vera Sans Mono,
            Courier New,
            monospace;
    }

    [data-invisible="true"] {
        display: none;
    }

    [data-hidden="true"] {
        visibility: hidden;
    }
</style>
